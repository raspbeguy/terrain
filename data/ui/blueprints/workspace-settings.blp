using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog ws_settings_dialog {
  title: "Workspace Settings";
  content-width: 480;

  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      title: "Binary Source";
      description: "Where the tofu/terraform binary comes from. Managed binaries live under $XDG_DATA_HOME/terrain/binaries; install versions from app Preferences.";

      Adw.ComboRow ws_binary_source_row {
        title: "Source";

        model: StringList {
          strings ["Managed (downloaded by terrain)", "Host PATH"]
        };
      }

      Adw.ComboRow ws_managed_engine_row {
        title: "Engine";
        visible: false;

        model: StringList {
          strings ["OpenTofu", "Terraform"]
        };
      }

      Adw.SwitchRow ws_managed_track_latest_row {
        title: "Track latest stable";
        subtitle: "Resolve the newest tagged release at run time. Falls back to the pinned version on lookup failure.";
        visible: false;
      }

      Adw.EntryRow ws_managed_version_row {
        title: "Version";
        visible: false;
      }
    }
  }
}
