using Gtk 4.0;
using Adw 1;

Box workspace_detail_root {
  orientation: vertical;

  Box {
    orientation: vertical;
    margin-top: 6;
    margin-bottom: 6;

    Adw.ViewSwitcher {
      policy: wide;
      stack: workspace_view_stack;
      halign: center;
    }
  }

  Adw.ViewStack workspace_view_stack {
    vexpand: true;
    hexpand: true;

    Adw.ViewStackPage {
      name: "overview";
      title: "Overview";
      icon-name: "view-list-symbolic";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Adw.PreferencesPage {
          Adw.PreferencesGroup {
            title: "Configuration";

            header-suffix: Button workspace_settings_button {
              icon-name: "emblem-system-symbolic";
              tooltip-text: "Workspace settings";

              styles ["flat"]
            };

            Adw.ActionRow workspace_path_row {
              title: "Working Directory";
              subtitle: "—";
            }

            Adw.ActionRow workspace_engine_row {
              title: "Execution Mode";
              subtitle: "Local";
            }

            Adw.ActionRow workspace_version_row {
              title: "Terraform Version";
              subtitle: "Auto-detect";
            }
          }

          Adw.PreferencesGroup {
            title: "State";

            Adw.ActionRow workspace_resources_row {
              title: "Resources";
              subtitle: "Run a plan to populate";
            }

            Adw.ActionRow workspace_serial_row {
              title: "State Serial";
              subtitle: "—";
            }
          }
        };
      };
    }

    Adw.ViewStackPage {
      name: "runs";
      title: "Runs";
      icon-name: "media-playback-start-symbolic";

      child: Box {
        orientation: vertical;

        Box {
          orientation: horizontal;
          spacing: 8;
          margin-start: 12;
          margin-end: 12;
          margin-top: 8;
          margin-bottom: 8;

          Box { hexpand: true; }

          Button workspace_refresh_runs_button {
            label: "Refresh";
            valign: center;

            styles ["flat"]
          }

          Button workspace_new_plan_button {
            label: "New Plan";
            valign: center;

            styles ["suggested-action"]
          }
        }

        Stack workspace_runs_stack {
          transition-type: crossfade;
          hexpand: true;
          vexpand: true;

          StackPage {
            name: "empty";

            child: Adw.StatusPage {
              icon-name: "media-playback-start-symbolic";
              title: "No Runs Yet";
              description: "Trigger a plan to populate this list.";
            };
          }

          StackPage {
            name: "list";

            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: ListBox workspace_runs_listbox {
                selection-mode: single;
                margin-start: 12;
                margin-end: 12;
                margin-bottom: 12;

                styles ["boxed-list"]
              };
            };
          }
        }
      };
    }

    Adw.ViewStackPage {
      name: "variables";
      title: "Variables";
      icon-name: "document-properties-symbolic";

      child: Box {
        orientation: vertical;

        Box {
          orientation: horizontal;
          spacing: 8;
          margin-start: 12;
          margin-end: 12;
          margin-top: 8;
          margin-bottom: 8;

          Box { hexpand: true; }

          Button workspace_refresh_vars_button {
            label: "Refresh";
            valign: center;

            styles ["flat"]
          }

          Button workspace_add_var_button {
            label: "Add Variable";
            valign: center;

            styles ["suggested-action"]
          }
        }

        Adw.Bin workspace_variables_container {
          hexpand: true;
          vexpand: true;
        }
      };
    }

    Adw.ViewStackPage {
      name: "state";
      title: "State";
      icon-name: "view-grid-symbolic";

      child: Box {
        orientation: vertical;

        Box {
          orientation: horizontal;
          margin-start: 12;
          margin-end: 12;
          margin-top: 8;
          margin-bottom: 8;

          Box {
            hexpand: true;
          }

          Button workspace_compare_state_button {
            label: "Compare…";
            valign: center;

            styles ["flat"]
          }

          Button workspace_refresh_state_button {
            label: "Refresh";
            valign: center;

            styles ["flat"]
          }
        }

        Adw.Banner workspace_state_banner {
          revealed: false;
          button-label: "";
        }

        Box {
          orientation: vertical;
          margin-start: 12;
          margin-end: 12;
          margin-bottom: 4;

          Adw.PreferencesGroup {
            Adw.ComboRow workspace_state_version_row {
              title: "Version";
              subtitle: "Switch between live state and saved snapshots";
            }
          }
        }

        Adw.Bin workspace_state_container {
          hexpand: true;
          vexpand: true;
        }
      };
    }
  }
}
