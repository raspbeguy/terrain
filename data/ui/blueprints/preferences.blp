using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog preferences_dialog {
  title: "Preferences";

  Adw.PreferencesPage {
    title: "General";
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: "Appearance";

      Adw.ComboRow theme_row {
        title: "Color Scheme";
        subtitle: "Follow the system, force light, or force dark";

        model: StringList {
          strings ["System", "Light", "Dark"]
        };
      }
    }

    Adw.PreferencesGroup {
      title: "Defaults";

      Adw.ComboRow engine_row {
        title: "Default Engine";
        subtitle: "Used when both tofu and terraform are installed";

        model: StringList {
          strings ["OpenTofu", "Terraform"]
        };
      }
    }

    Adw.PreferencesGroup {
      title: "Container Runtime";
      description: "Optional. Lets you launch runs inside a container instead of as a host subprocess — useful for pinning tofu/terraform versions per workspace or isolating provider plugins.";

      Adw.EntryRow runtime_path_row {
        title: "Runtime binary path";
      }

      Adw.ComboRow default_run_mode_row {
        title: "Default for new workspaces";
        subtitle: "Existing workspaces keep their per-workspace setting";

        model: StringList {
          strings ["Subprocess (host)", "Bubblewrap", "Container"]
        };
      }

      Adw.EntryRow tofu_image_row {
        title: "Default OpenTofu image";
      }

      Adw.EntryRow terraform_image_row {
        title: "Default Terraform image";
      }
    }
  }

  Adw.PreferencesPage {
    title: "Binaries";
    icon-name: "applications-system-symbolic";

    Adw.PreferencesGroup tofu_group {
      title: "OpenTofu";
      description: "Detected from PATH";

      Adw.ActionRow tofu_row {
        title: "tofu";
        subtitle: "—";

        styles ["property"]
      }
    }

    Adw.PreferencesGroup terraform_group {
      title: "Terraform";
      description: "Detected from PATH";

      Adw.ActionRow terraform_row {
        title: "terraform";
        subtitle: "—";

        styles ["property"]
      }
    }

    Adw.PreferencesGroup managed_binaries_group {
      title: "Managed Binaries";
      description: "Versions terrain has downloaded into $XDG_DATA_HOME/terrain/binaries — use these per-workspace without a host install.";

      header-suffix: Gtk.Box {
        spacing: 6;
        valign: center;

        Gtk.Button clean_managed_binaries_button {
          label: "Clean unused";

          styles ["flat"]
        }

        Gtk.Button install_managed_binary_button {
          label: "Install version";

          styles ["flat", "suggested-action"]
        }
      };
    }
  }

  Adw.PreferencesPage {
    title: "Backends";
    icon-name: "network-server-symbolic";

    Adw.PreferencesGroup remote_backends_group {
      title: "Remote Backends";
      description: "Refresh capability bitmasks if a backend has been upgraded since the last connect.";
    }
  }
}
