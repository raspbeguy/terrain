<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <name>@APP_NAME@</name>
  <summary>@APP_SUMMARY@</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.raspbeguy">
    <name>raspbeguy</name>
  </developer>

  <description>
    <p>
      Terrain is a native GNOME desktop application for managing Terraform
      and OpenTofu workflows, inspired by Terraform Enterprise and OTF.
    </p>
    <p>
      It supports both local projects (cloned from a git URL into the
      app's own data directory) and remote backends (HCP Terraform,
      self-hosted Terraform Enterprise, OTF) through a single unified
      interface: workspaces, runs, variables, state, and structured
      plan diffs render the same whether the data comes from a
      subprocess or a remote API.
    </p>
    <p>Features:</p>
    <ul>
      <li>Local projects added by git URL + optional subpath; multiple subpaths share one clone</li>
      <li>Terraform workspaces surfaced as first-class sidebar entries with create/delete actions</li>
      <li>Streamed plan/apply runs with cancel; remote runs via API polling</li>
      <li>TFE-style per-resource plan diffs with action badges and attribute-level changes</li>
      <li>State visualization: resource tree with attribute viewer and history of past versions</li>
      <li>Variable management with sensitive-value masking via the system keyring</li>
      <li>Run history persisted on disk (local) or fetched from the API (remote)</li>
      <li>Managed binaries: Terrain downloads and caches official OpenTofu / Terraform releases per workspace</li>
      <li>In-app SSH key management and HTTPS token storage for git authentication, all sandbox-clean</li>
    </ul>
    <p>
      Sensitive credentials are stored in the platform secret service
      (libsecret on Linux, Keychain on macOS, Credential Vault on
      Windows), never in plaintext on disk.
    </p>
  </description>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>

  <url type="homepage">https://raspbeguy.github.io/terrain/</url>
  <url type="bugtracker">https://github.com/raspbeguy/terrain/issues</url>
  <url type="vcs-browser">https://github.com/raspbeguy/terrain</url>

  <categories>
    <category>Development</category>
    <category>GTK</category>
  </categories>

  <keywords>
    <keyword>terraform</keyword>
    <keyword>opentofu</keyword>
    <keyword>tofu</keyword>
    <keyword>infrastructure</keyword>
    <keyword>iac</keyword>
    <keyword>devops</keyword>
    <keyword>cloud</keyword>
  </keywords>

  <content_rating type="oars-1.1" />

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>

  <supports>
    <control>touch</control>
  </supports>

  <branding>
    <color type="primary" scheme_preference="light">#c5d8c0</color>
    <color type="primary" scheme_preference="dark">#3a4a36</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <caption>Workspace overview with the runs tab populated</caption>
      <image>https://raw.githubusercontent.com/raspbeguy/terrain/main/docs/screenshots/workspace.png</image>
    </screenshot>
    <screenshot>
      <caption>Plan diff viewer showing per-resource changes</caption>
      <image>https://raw.githubusercontent.com/raspbeguy/terrain/main/docs/screenshots/plan-diff.png</image>
    </screenshot>
    <screenshot>
      <caption>State tree with attribute viewer</caption>
      <image>https://raw.githubusercontent.com/raspbeguy/terrain/main/docs/screenshots/state-tree.png</image>
    </screenshot>
    <screenshot>
      <caption>Workspace variables with sensitive values masked</caption>
      <image>https://raw.githubusercontent.com/raspbeguy/terrain/main/docs/screenshots/variables.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="@VERSION@" date="2026-05-08">
      <description>
        <p>
          Local projects are now added by git URL plus an optional subpath
          rather than a filesystem folder picker; multiple subpaths share
          one clone. Terraform workspaces appear as first-class sidebar
          entries (create / delete from the kebab; runs pinned via
          TF_WORKSPACE).
        </p>
        <p>
          Managed binary mode is the default for new workspaces. Terrain
          downloads and caches official OpenTofu / Terraform releases
          per-version; runs never hit the network. Container and
          bubblewrap run modes were removed.
        </p>
        <p>
          In-app SSH key management plus libsecret-stored HTTPS git
          tokens for forge authentication. One-click "Sync from git
          remote" on every workspace.
        </p>
      </description>
    </release>
    <release version="0.0.1" date="2026-05-06">
      <description>
        <p>
          Initial release. Manage local Terraform and OpenTofu projects
          and remote backends (HCP Terraform, Terraform Enterprise, OTF)
          from a single GNOME window, with streamed plan and apply logs,
          per-resource plan diffs, a state browser, variable editing
          with keyring-backed secrets, and replayable run history.
        </p>
      </description>
    </release>
  </releases>
</component>
